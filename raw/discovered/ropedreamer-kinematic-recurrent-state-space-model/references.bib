	keywords = {Deformable models, Deformation, Dynamics, Feature extraction, Grasping, Manipulation planning, Manipulator dynamics, Predictive control, Predictive models, Real-time systems, Shape control, deformable object manipulation, dual arm manipulation, model learning},
	pages = {303--309},
}
