	keywords = {Computer Science - Machine Learning, Computer Science - Robotics},
}

@inproceedings{burgh-olivan_controlling_2025,
	title = {Controlling the {Shape} of {Deformable} {Linear} {Objects} in {3D} with a {Simple} {Geometric} {Model}},
