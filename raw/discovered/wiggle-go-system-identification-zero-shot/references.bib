@article{fritzkowski_dynamics_2010,
	title = {Dynamics of a rope modeled as a multi-body system with elastic joints},
	volume = {46},
	issn = {1432-0924},
	url = {https://doi.org/10.1007/s00466-010-0524-y},
	doi = {10.1007/s00466-010-0524-y},
	abstract = {A discrete model of a rope with spiral springs in joints is considered, the aim being to include transverse elasticity of the rope. Elastic characteristic of the springs is derived on the basis of simple geometrical formulas and the classical curvature-bending moment relationship for beams. Lagrange’s equations of motion are presented and their complexity is discussed from the computational point of view. Numerical experiments are performed for a system with both scleronomic and rheonomic constraints. The influence of the elasticity on behaviour of the model is analyzed. Results validity is examined in terms of basic energy principles.},
	number = {6},
	journal = {Computational Mechanics},
	author = {Fritzkowski, Paweł and Kamiński, Henryk},
	month = nov,
	year = {2010},
	pages = {901--909},
}

