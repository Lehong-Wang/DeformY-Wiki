editor = {Nicolae Lobontiu},
booktitle = {System Dynamics for Engineering Students (Second Edition)},
publisher = {Academic Press},
edition = {Second Edition},
address = {Boston},
pages = {541-592},
year = {2018},
isbn = {978-0-12-804559-6},
doi = {https://doi.org/10.1016/B978-0-12-804559-6.00011-7},
url = {https://www.sciencedirect.com/science/article/pii/B9780128045596000117},
author = {Nicolae Lobontiu},
keywords = {Feedback, Control, Block diagram, Controller, Prefilter, Unity feedback, Sensitivity analysis, Disturbance, Open loop, Closed loop},
abstract = {This chapter introduces the feedback control of single-input, single-output (SISO) and multiple-input, multiple-output (MIMO) dynamic systems. The main tool in modeling such feedback control systems is the block diagram that consists of the transfer functions defining the various subsystems and of the Laplace-domain signals connecting them. Each constitutive block is defined by transfer functions, and the algebra of blocks is used to formulate overall system qualifiers such as feed-forward, open-loop, and closed-loop transfer functions. Controllers and compensators are defined and characterized, as well. This chapter includes numerous examples of physical systems that operate as components in feedback systems or as full control systems.}
}

@incollection{Laplace,
title = {Chapter 3 - Solving Differential Equations in the Laplace Domain},
editor = {Mark A. Haidekker},
booktitle = {Linear Feedback Controls},
publisher = {Elsevier},
address = {Oxford},
pages = {27-56},
year = {2013},
isbn = {978-0-12-405875-0},
doi = {https://doi.org/10.1016/B978-0-12-405875-0.00003-6},
url = {https://www.sciencedirect.com/science/article/pii/B9780124058750000036},
author = {Mark A. Haidekker},
keywords = {Laplace transform, Fourier transform, Laplace correspondence tables, Ordinary differential equations in the Laplace domain transient response steady-state response building blocks of linear systems operational amplifiers},
abstract = {The Laplace transform is a particularly elegant way to solve linear differential equations with constant coefficients. The Laplace transform describes signals and systems not as functions of time, but as functions of a complex variable s. When transformed into the Laplace domain, differential equations become polynomials of s. Solving a differential equation in the time domain becomes a simple polynomial multiplication and division in the Laplace domain. However, the input and output signals are also in the Laplace domain, and any system response must undergo an inverse Laplace transform to become a meaningful time-dependent signal. In this chapter, the Laplace transform is introduced, and the manipulation of signals and systems in the Laplace domain explained. Tools to find time-domain and Laplace-domain correspondences are presented.}
}

