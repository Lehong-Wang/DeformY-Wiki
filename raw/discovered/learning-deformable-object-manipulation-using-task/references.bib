@inproceedings{gurumurthy_deep_2023,
	title = {Deep Off-Policy Iterative Learning Control},
	url = {https://proceedings.mlr.press/v211/gurumurthy23b.html},
	abstract = {Reinforcement learning has emerged as a powerful paradigm to learn control policies while making few assumptions about the environment. However, this lack of assumptions in popular {RL} algorithms also leads to sample inefficiency. Furthermore, we often have access to a simulator that can provide approximate gradients for the rewards and dynamics of the environment. Iterative learning control ({ILC}) approaches have been shown to be very efficient at learning policies by using approximate simulator gradients to speed up optimization. However, they lack the generality of reinforcement learning approaches. In this paper, we take inspiration from {ILC} and propose an update equation for the value-function gradients (computed using the dynamics Jacobians and reward gradient obtained from an approximate simulator) to speed up value-function and policy optimization. We add this update to an off-the-shelf off-policy reinforcement learning algorithm and demonstrate that using the value-gradient update leads to a significant improvement in sample efficiency (and sometimes better performance) both when learning from scratch in a new environment and while fine-tuning a pre-trained policy in a new environment. Moreover, we observe that policies pretrained in the simulator using the simulator jacobians obtain better zero-shot transfer performance and adapt much faster in a new environment.},
	eventtitle = {Learning for Dynamics and Control Conference},
	pages = {639--652},
	booktitle = {Proceedings of The 5th Annual Learning for Dynamics and Control Conference},
	publisher = {{PMLR}},
	author = {Gurumurthy, Swaminathan and Kolter, J. Zico and Manchester, Zachary},
	urldate = {2025-04-24},
	date = {2023-06-06},
	langid = {english},
	file = {Full Text PDF:/Users/ksuresh/Zotero default/storage/MQUVCHX6/Gurumurthy et al. - 2023 - Deep Off-Policy Iterative Learning Control.pdf:application/pdf},
}

@inproceedings{bai_deep_2025,
	title = {Deep Reinforcement Learning of Robotic Manipulation for Whip Targeting},
	url = {https://ieeexplore.ieee.org/abstract/document/10979109},
	doi = {10.1109/SIMPAR62925.2025.10979109},
	abstract = {This paper aims at a deep reinforcement learning ({DRL}) controller for fast ({\textless} 1.5s) manipulation of a flexible tool (i.e., whip) to hit a target in 3D space. The controller consists of a {DRL} algorithm for optimizing joint motions, and a proportional-derivative ({PD}) mechanism for tracking the optimized motions. Their objective is to minimize the distance between the whip-end-tip and the target. The proposed controller was validated in a 7-{DOF} robot arm by comparing four {DRL} algorithms in the physical simulator {MuJoCo}. It shows that the proximal policy optimization ({PPO}) outperforms others by obtaining the maximum average reward. Notably, {PPO} can still effectively interact with the environment under sparse or even unrewarding conditions, making it a robust choice for complex and dynamic tasks. Our work provides preliminary knowledge of {DRL} applications to fast robotic arm control in flexible object manipulation.},
	eventtitle = {2025 {IEEE} International Conference on Simulation, Modeling, and Programming for Autonomous Robots ({SIMPAR})},
	pages = {1--6},
