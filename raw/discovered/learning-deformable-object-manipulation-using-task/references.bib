	urldate = {2025-05-27},
	date = {2024-10},
	note = {{ISSN}: 2153-0866},
	keywords = {Redundancy, Imitation learning, Intelligent robots, Kinematics, Robot control},
	file = {Full Text PDF:/Users/ksuresh/Zotero default/storage/A8AAUQF8/Nah et al. - 2024 - On the Modularity of Elementary Dynamic Actions.pdf:application/pdf},
}

